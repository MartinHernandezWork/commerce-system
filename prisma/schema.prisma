generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  sku         String?   @unique
  barcode     String?   @unique
  description String?
  stock       Float     @default(0)
  showInPOS   Boolean   @default(true)
  unitType    UnitType  @default(UNIT)
  costPrice   Float
  salePrice   Float
  imageUrl    String?
  deletedAt   DateTime?

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales                Sale[]
  stockMovements       StockMovement[]
  recipeItems          RecipeItem[]
  orderItems           OrderItem[]
  orderItemIngredients OrderItemIngredient[]
  orderItemExtras      OrderItemExtra[]

  @@map("product")
}

model Recipe {
  id        Int       @id @default(autoincrement())
  name      String
  price     Float     @default(0)
  imageUrl  String?
  deletedAt DateTime?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  items       RecipeItem[]
  recipeSales RecipeSale[]
  orderItems  OrderItem[]

  @@map("recipe")
}

model RecipeItem {
  id Int @id @default(autoincrement())

  quantity Float

  recipeId  Int
  productId Int

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("recipeitem")
}

model RecipeSale {
  id Int @id @default(autoincrement())

  recipeId Int
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  recipeName String
  unitPrice  Float

  groupId Int
  group   SaleGroup @relation(fields: [groupId], references: [id])

  quantity  Float
  createdAt DateTime @default(now())

  @@map("recipesale")
}

model Supplier {
  id Int @id @default(autoincrement())

  name    String
  phone   String?
  email   String?
  address String?

  products Product[]

  createdAt DateTime @default(now())

  @@map("supplier")
}

model Category {
  id Int @id @default(autoincrement())

  name String

  products Product[]
  recipes  Recipe[]

  @@map("category")
}

model Sale {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productName String
  unitPrice   Float
  quantity    Float
  totalPrice  Float

  createdAt DateTime @default(now())

  groupId Int?
  group   SaleGroup? @relation(fields: [groupId], references: [id])

  @@map("sale")
}

model SaleGroup {
  id Int @id @default(autoincrement())

  total Float

  createdAt DateTime @default(now())

  customerName String?

  paymentMethod PaymentMethod @default(CASH)

  cashAmount     Float @default(0)
  transferAmount Float @default(0)
  cashReceived   Float @default(0)
  change         Float @default(0)

  sales       Sale[]
  recipeSales RecipeSale[]

  cashId Int?
  cash   CashRegister? @relation(fields: [cashId], references: [id])

  order Order?

  @@map("salegroup")
}

model Order {
  id Int @id @default(autoincrement())

  groupId Int       @unique
  group   SaleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  status OrderStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  items OrderItem[]

  @@map("order")
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type OrderItemType

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  recipeId Int?
  recipe   Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  name      String
  quantity  Float
  unitPrice Float

  ingredients OrderItemIngredient[]
  extras      OrderItemExtra[]

  @@map("orderitem")
}

model OrderItemIngredient {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  quantity Float

  @@map("orderitemingredient")
}

model OrderItemExtra {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name String

  unitIndex Int @default(0)

  quantity Float @default(1)

  category ExtraCategory

  @@map("orderitemextra")
}

model CashRegister {
  id Int @id @default(autoincrement())

  openedAt DateTime  @default(now())
  closedAt DateTime?

  initial Float
  final   Float?

  saleGroups SaleGroup[]

  @@map("cashregister")
}

model StockMovement {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     StockMovementType
  quantity Float
  note     String?

  createdAt DateTime @default(now())

  @@map("stockmovement")
}

model User {
  id Int @id @default(autoincrement())

  username     String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Note {
  id         Int      @id @default(autoincrement())
  authorName String
  type       NoteType
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([authorName])
  @@map("note")
}

enum NoteType {
  MERCADERIA_INGRESO
  MERCADERIA_PERDIDA
  CAMBIO
  OTRA
}


enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  LOSS
}

enum OrderStatus {
  PENDING
  COMPLETED
}

enum OrderItemType {
  PRODUCT
  RECIPE
}

enum ExtraCategory {
  ADEREZO
  DESCARTABLE
}

enum PaymentMethod {
  CASH
  TRANSFER
  MIXED
}

enum UnitType {
  UNIT
  G
  KG
}

enum UserRole {
  ADMIN
  EMPLOYEE
}
